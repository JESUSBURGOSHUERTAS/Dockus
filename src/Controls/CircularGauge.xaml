<UserControl x:Class="Dockus.Controls.CircularGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="60">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Circular Ring Container -->
        <Grid x:Name="ContainerGrid" Width="44" Height="44" HorizontalAlignment="Center">
            <!-- Background Ring -->
            <Ellipse Stroke="#1F293D" StrokeThickness="3.5" Margin="2"/>

            <!-- Foreground Arc -->
            <Path x:Name="ArcPath" Stroke="#10B981" StrokeThickness="3.5" Margin="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- Centered Percentage Text -->
            <TextBlock x:Name="TxtValue" Text="100%" Foreground="#F8FAFC" FontSize="11" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Subtitle Label Below Circle -->
        <TextBlock x:Name="TxtLabel" Text="Semana" Foreground="#94A3B8" FontSize="9.5" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
    </StackPanel>
</UserControl>
