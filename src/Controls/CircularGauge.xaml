<UserControl x:Class="Dockus.Controls.CircularGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="52" d:DesignWidth="56"
             ClipToBounds="False">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0" ClipToBounds="False">
        <!-- Top Header (e.g. GEMINI, CLAUDE) -->
        <TextBlock x:Name="TxtHeader" Text="GEMINI" Foreground="#94A3B8" FontSize="8.0" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,1" Visibility="Collapsed"/>

        <!-- Circular Ring Container: 30x30 Compact & Unclipped -->
        <Grid x:Name="ContainerGrid" Width="30" Height="30" HorizontalAlignment="Center" ClipToBounds="False">
            <!-- Background Ring -->
            <Ellipse x:Name="BgEllipse" Stroke="#253347" StrokeThickness="2.2" Width="23" Height="23"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Foreground Arc -->
            <Path x:Name="ArcPath" Stroke="#10B981" StrokeThickness="2.2"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- Centered Percentage Text (1px smaller: 8.5) -->
            <TextBlock x:Name="TxtValue" Text="100%" Foreground="#F8FAFC" FontSize="8.5" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Subtitle Label Below Circle (e.g. 3h 54m) -->
        <TextBlock x:Name="TxtLabel" Text="3h 54m" Foreground="#38BDF8" FontSize="8.0" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,1,0,0" TextAlignment="Center" ClipToBounds="False"/>
    </StackPanel>
</UserControl>
