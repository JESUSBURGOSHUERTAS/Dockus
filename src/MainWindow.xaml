<Window x:Class="Dockus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Dockus.Converters"
        mc:Ignorable="d"
        Title="Dockus - AI Token Glass Monitor"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="500"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Window.Resources>
        <converters:PercentToBrushConverter x:Key="PercentToBrushConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Futuristic Glowing Glass Brushes -->
        <SolidColorBrush x:Key="GlassBackground" Color="#E60D131F"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#3338BDF8"/>
        <SolidColorBrush x:Key="CardBackground" Color="#221E293B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2638BDF8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextAccent" Color="#38BDF8"/>
        <SolidColorBrush x:Key="TextEmerald" Color="#10B981"/>
        <SolidColorBrush x:Key="TextAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextRose" Color="#F43F5E"/>

        <!-- Button Flat Glass Style -->
        <Style x:Key="GlassBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Icon Button Style -->
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3338BDF8"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Provider Tab Radio Button Style -->
        <Style x:Key="ProviderTabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ProgressBar Style -->
        <Style x:Key="NeonProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#38BDF8" Offset="0"/>
                                        <GradientStop Color="#818CF8" Offset="0.7"/>
                                        <GradientStop Color="#C084FC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Outer Glow and Frosted Acrylic Glass -->
    <Grid Margin="12">
        <Border x:Name="MainGlassBorder"
                Background="{StaticResource GlassBackground}"
                BorderThickness="1.2"
                CornerRadius="16"
                SnapsToDevicePixels="True">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6638BDF8" Offset="0"/>
                    <GradientStop Color="#44818CF8" Offset="0.5"/>
                    <GradientStop Color="#66C084FC" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#38BDF8" BlurRadius="22" Direction="270" ShadowDepth="3" Opacity="0.35"/>
            </Border.Effect>

            <StackPanel Orientation="Vertical">

                <!-- 1. COMPACT DOCK BAR (Always Visible / Sits above Taskbar) -->
                <Grid x:Name="CompactBar" Height="50" Margin="14,0" Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Provider Badge -->
                        <ColumnDefinition Width="*"/>    <!-- Center Context & Bar -->
                        <ColumnDefinition Width="Auto"/> <!-- Cache & Controls -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Provider Brand Badge with Pulse Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="7,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Usage.IconGlyph}" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding CurrentProviderShortName}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Pulse Indicator (Green when active, Sky Blue when idle) -->
                        <Ellipse x:Name="SyncDot" Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center"
                                 Fill="{Binding Usage.IsActiveNow, Converter={StaticResource PercentToBrushConverter}, ConverterParameter=dot}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>

                    <!-- Center: Context Remaining & Progress Bar -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Info Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="Contexto: " Foreground="#94A3B8" FontSize="10.5"/>
                                <TextBlock Text="{Binding Usage.FormattedCurrentContext}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="10.5"/>
                                <TextBlock Text=" / " Foreground="#64748B" FontSize="10.5"/>
                                <TextBlock Text="{Binding Usage.FormattedMaxContext}" Foreground="#94A3B8" FontSize="10.5"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Usage.FormattedRemaining}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10.5"/>
                                <TextBlock Text=" libres (" Foreground="#94A3B8" FontSize="10.5"/>
                                <TextBlock Text="{Binding Usage.FormattedPercentRemaining}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10.5"/>
                                <TextBlock Text=")" Foreground="#94A3B8" FontSize="10.5"/>
                            </StackPanel>
                        </Grid>

                        <!-- Progress Bar -->
                        <ProgressBar Grid.Row="1"
                                     Style="{StaticResource NeonProgressBarStyle}"
                                     Value="{Binding Usage.ContextUsagePercentage, Mode=OneWay}"
                                     Maximum="100"
                                     Minimum="0"/>
                    </Grid>

                    <!-- Right: Cache Pill + Expand Button + Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Cache Pill Badge -->
                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,6,0"
                                ToolTip="Ahorro de tokens gracias a Prompt Caching">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ " Foreground="#10B981" FontSize="10"/>
                                <TextBlock Text="{Binding Usage.FormattedCacheHit}" Foreground="#10B981" FontWeight="Bold" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <!-- Expand/Collapse Button -->
                        <Button Style="{StaticResource IconBtnStyle}" Click="BtnToggleExpand_Click"
                                ToolTip="Expandir / colapsar panel detallado de tokens">
                            <TextBlock Text="{Binding ExpandIconText}" FontSize="12" Foreground="#94A3B8"/>
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource IconBtnStyle}" Click="BtnClose_Click" Margin="2,0,0,0"
                                ToolTip="Cerrar monitor">
                            <TextBlock Text="✕" FontSize="10" Foreground="#64748B"/>
                        </Button>

                        <!-- Drag Grab Handle -->
                        <TextBlock Text="⋮⋮" Foreground="#475569" FontSize="13" VerticalAlignment="Center" Margin="3,0,0,0" ToolTip="Arrastrar para mover (Auto-snap a barra)"/>
                    </StackPanel>
                </Grid>

                <!-- 2. EXPANDED FLYOUT DASHBOARD (Visible when IsExpanded == True) -->
                <Grid x:Name="ExpandedFlyout" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="14,0,14,14">
                    <StackPanel Orientation="Vertical">

                        <Separator Background="#2638BDF8" Height="1" Margin="0,0,0,12"/>

                        <!-- Conversation Title & Real-Time Step Header -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Usage.ConversationTitle}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="Sesión Antigravity: " Foreground="#64748B" FontSize="10.5"/>
                                    <TextBlock Text="{Binding ShortConversationId}" Foreground="#94A3B8" FontSize="10.5" FontFamily="Consolas"/>
                                    <TextBlock Text=" · " Foreground="#64748B" FontSize="10.5"/>
                                    <TextBlock Text="{Binding Usage.StepCount, StringFormat='Paso {0}'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10.5"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Manual Refresh Button -->
                            <Button Grid.Column="1" Style="{StaticResource GlassBtnStyle}" Padding="7,4" Click="BtnRefresh_Click" VerticalAlignment="Center">
                                <TextBlock Text="↻ Actualizar" FontSize="10.5"/>
                            </Button>
                        </Grid>

                        <!-- Provider Switcher Tabs (Gemini, API, OpenAI, Claude, DeepSeek) -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,0,14">
                            <UniformGrid Rows="1">
                                <RadioButton Content="✦ Antigravity" Style="{StaticResource ProviderTabRadio}" IsChecked="{Binding IsProviderAntigravity, Mode=OneWay}" Checked="ProviderRadio_Checked" Tag="antigravity_gemini"/>
                                <RadioButton Content="✦ Gemini API" Style="{StaticResource ProviderTabRadio}" IsChecked="{Binding IsProviderGeminiApi, Mode=OneWay}" Checked="ProviderRadio_Checked" Tag="gemini_api"/>
                                <RadioButton Content="⚙ OpenAI" Style="{StaticResource ProviderTabRadio}" IsChecked="{Binding IsProviderOpenAi, Mode=OneWay}" Checked="ProviderRadio_Checked" Tag="openai"/>
                                <RadioButton Content="✻ Claude" Style="{StaticResource ProviderTabRadio}" IsChecked="{Binding IsProviderClaude, Mode=OneWay}" Checked="ProviderRadio_Checked" Tag="claude"/>
                                <RadioButton Content="🐋 DeepSeek" Style="{StaticResource ProviderTabRadio}" IsChecked="{Binding IsProviderDeepSeek, Mode=OneWay}" Checked="ProviderRadio_Checked" Tag="deepseek"/>
                            </UniformGrid>
                        </Border>

                        <!-- 4 Core Metric Glass Cards (Grid 2x2) -->
                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Ventana de Contexto (Ocupado) -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="VENTANA DE CONTEXTO" Foreground="#94A3B8" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Usage.FormattedCurrentContext}" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text=" tokens" Foreground="#64748B" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Usage.FormattedPercentUsed, StringFormat={}{0} del límite total}" Foreground="#38BDF8" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Cuánto me Queda (Tokens Restantes) -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="CUÁNTO ME QUEDA" Foreground="#94A3B8" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Usage.FormattedRemaining}" Foreground="#10B981" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text=" tokens" Foreground="#64748B" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Usage.FormattedPercentRemaining, StringFormat={}{0} libre antes de compactar}" Foreground="#10B981" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Ahorro por Cache Gemini -->
                            <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="AHORRO PROMPT CACHE" Foreground="#94A3B8" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FormattedLastTurnCache}" Foreground="#C084FC" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text=" en turno" Foreground="#64748B" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Usage.FormattedCacheHit, StringFormat='⚡ Tasa acierto: {0}'}" Foreground="#A855F7" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Consumo Total de Hoy -->
                            <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="CONSUMO TOTAL HOY" Foreground="#94A3B8" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Usage.FormattedTodayTotal}" Foreground="#F59E0B" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text=" tokens" Foreground="#64748B" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TodayBreakdownText}" Foreground="#94A3B8" FontSize="9.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Recent Conversations Section -->
                        <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="CONVERSACIONES RECIENTES" Foreground="#64748B" FontSize="9.5" FontWeight="Bold"/>
                                    <TextBlock Text="Tokens estimados" HorizontalAlignment="Right" Foreground="#64748B" FontSize="9.5"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding RecentConversations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E293B" CornerRadius="6" Padding="8,5" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" Foreground="#F1F5F9" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                            <TextBlock Text="{Binding FormattedRelativeTime}" Foreground="#64748B" FontSize="9.5"/>
                                                            <TextBlock Text=" · " Foreground="#475569" FontSize="9.5"/>
                                                            <TextBlock Text="{Binding StepCount, StringFormat={}{0} pasos}" Foreground="#94A3B8" FontSize="9.5"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedContext, StringFormat={}{0} tokens}" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Settings & Docking Controls Footer -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="10,8">
                            <StackPanel>
                                <!-- Docking Position Buttons -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Posición en Barra:" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Abajo Der" Style="{StaticResource GlassBtnStyle}" Margin="2,0" Padding="6,3" Click="BtnDock_Click" Tag="BottomRight"/>
                                        <Button Content="Centro" Style="{StaticResource GlassBtnStyle}" Margin="2,0" Padding="6,3" Click="BtnDock_Click" Tag="BottomCenter"/>
                                        <Button Content="Abajo Izq" Style="{StaticResource GlassBtnStyle}" Margin="2,0" Padding="6,3" Click="BtnDock_Click" Tag="BottomLeft"/>
                                        <Button Content="Flotante" Style="{StaticResource GlassBtnStyle}" Margin="2,0" Padding="6,3" Click="BtnDock_Click" Tag="Floating"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Limit Context Selector -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Límite Ventana:" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="1M Flash" Style="{StaticResource GlassBtnStyle}" Margin="2,0" Padding="5,2" Click="BtnLimit_Click" Tag="1000000"/>
                                        <Button Content="2M Pro" Style="{StaticResource GlassBtnStyle}" Margin="2,0" Padding="5,2" Click="BtnLimit_Click" Tag="2000000"/>
                                        <Button Content="200k Claude" Style="{StaticResource GlassBtnStyle}" Margin="2,0" Padding="5,2" Click="BtnLimit_Click" Tag="200000"/>
                                        <Button Content="128k GPT" Style="{StaticResource GlassBtnStyle}" Margin="2,0" Padding="5,2" Click="BtnLimit_Click" Tag="128000"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Opacity Slider & Always-on-top -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Content="Siempre visible" Foreground="#94A3B8" FontSize="10.5" IsChecked="{Binding Settings.AlwaysOnTop}" Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Opacidad:" Foreground="#94A3B8" FontSize="10.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <Slider Width="90" Minimum="0.50" Maximum="1.0" Value="{Binding Settings.GlassOpacity}" ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FormattedOpacity}" Foreground="#38BDF8" FontSize="10.5" Width="30" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
